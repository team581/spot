{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"bootstrap-sha": "4e560f374d79d6a2808839c1db6a381a393aad10",
	"release-type": "node",
	"include-component-in-tag": true,
	"plugins": ["node-workspace"],
	"packages": {
		".": {
			"component": "spot",
			"release-type": "simple",
			"initial-version": "2026.0.0",
			"pull-request-title-pattern": "chore(spot): release ${version}",
			"exclude-paths": ["apps/vscode-camera-preview", "packages/camera-viewer", "packages/java-client"],
			"extra-files": [
				{
					"type": "toml",
					"path": "apps/vision/Cargo.toml",
					"jsonpath": "$.package.version"
				},
				{
					"type": "toml",
					"path": "apps/vision/Cargo.lock",
					"jsonpath": "$.package[?(@.name.value==='spot-vision')].version"
				},
				"nix/packages.nix"
			]
		},
		"apps/vscode-camera-preview": {
			"component": "camera-preview",
			"draft": true,
			"force-tag-creation": true,
			"pull-request-title-pattern": "chore(vscode-camera-preview): release ${version}"
		},
		"packages/camera-viewer": {
			"component": "camera-viewer",
			"pull-request-title-pattern": "chore(camera-viewer): release ${version}"
		},
		"packages/java-client": {
			"component": "java-client",
			"release-type": "simple",
			"initial-version": "2026.0.0",
			"pull-request-title-pattern": "chore(java-client): release ${version}",
			"extra-files": [
				{
					"type": "json",
					"path": "/apps/docs/public/vendordep.json",
					"jsonpath": "$.version"
				},
				{
					"type": "json",
					"path": "/apps/docs/public/vendordep.json",
					"jsonpath": "$.javaDependencies[0].version"
				}
			]
		}
	}
}
