{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"bootstrap-sha": "2d139625a2470cfa56934950a026ca23807ff8a6",
	"release-type": "node",
	"include-component-in-tag": true,
	"plugins": ["node-workspace"],
	"packages": {
		"apps/vscode-camera-preview": {
			"component": "camera-preview",
			"draft": true,
			"force-tag-creation": true,
			"pull-request-title-pattern": "chore(vscode-camera-preview): release ${version}"
		},
		"packages/camera-viewer": {
			"component": "camera-viewer",
			"pull-request-title-pattern": "chore(camera-viewer): release ${version}"
		},
		"packages/java-client": {
			"component": "java-client",
			"release-type": "simple",
			"initial-version": "2026.0.0",
			"pull-request-title-pattern": "chore(java-client): release ${version}",
			"extra-files": [
				{
					"type": "json",
					"path": "/apps/docs/public/vendordep.json",
					"jsonpath": "$.version"
				},
				{
					"type": "json",
					"path": "/apps/docs/public/vendordep.json",
					"jsonpath": "$.javaDependencies[0].version"
				}
			]
		}
	}
}
