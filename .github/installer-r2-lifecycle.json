{
	"rules": [
		{
			"id": "expire-installer-after-seven-days",
			"enabled": true,
			"conditions": { "prefix": "latest/" },
			"deleteObjectsTransition": {
				"condition": { "type": "Age", "maxAge": 604800 }
			},
			"abortMultipartUploadsTransition": {
				"condition": { "type": "Age", "maxAge": 86400 }
			}
		}
	]
}
