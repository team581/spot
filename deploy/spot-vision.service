[Unit]
Description=Team 581 Spot Vision
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=spot-vision
Group=spot-vision
SupplementaryGroups=video
WorkingDirectory=/opt/spot-vision
ExecStart=/opt/spot-vision/.venv/bin/spot-vision --json-logs daemon --config /etc/spot-vision/spot.json
Restart=on-failure
RestartSec=1
WatchdogSec=10
NotifyAccess=main
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/spot-vision

[Install]
WantedBy=multi-user.target
