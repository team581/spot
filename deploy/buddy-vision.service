[Unit]
Description=Team 581 Buddy Vision
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=buddy-vision
Group=buddy-vision
SupplementaryGroups=video
WorkingDirectory=/opt/buddy-vision
ExecStart=/opt/buddy-vision/.venv/bin/buddy-vision --json-logs daemon --config /etc/buddy-vision/buddy.json
Restart=on-failure
RestartSec=1
WatchdogSec=10
NotifyAccess=main
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/buddy-vision

[Install]
WantedBy=multi-user.target
