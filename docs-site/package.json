{
	"name": "spot-docs",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev --host 127.0.0.1 --port 5814",
		"check": "astro sync && tsc --noEmit --runExternalCode",
		"build": "pnpm check && NODE_ENV=production astro build",
		"build:jetson": "DOCS_TARGET=jetson NODE_ENV=production astro build",
		"preview": "astro preview --host 127.0.0.1 --port 5814",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.3.3",
		"@astrojs/markdown-satteri": "0.4.4",
		"@astrojs/mdx": "8.1.0",
		"@astrojs/starlight": "0.42.6",
		"@team581/starlight-theme": "0.0.0",
		"astro": "7.4.0",
		"pele": "1.7.0"
	},
	"devDependencies": {
		"@astrojs/ts-content-mapper": "0.2.0",
		"parse5": "8.0.1",
		"typescript": "7.1.0-beta"
	}
}
