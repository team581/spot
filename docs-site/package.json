{
	"name": "spot-docs",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev --host 127.0.0.1 --port 5814",
		"build": "astro check && NODE_ENV=production astro build",
		"build:jetson": "DOCS_TARGET=jetson NODE_ENV=production astro build",
		"preview": "astro preview --host 127.0.0.1 --port 5814",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"knip": "knip",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.3.3",
		"@astrojs/markdown-satteri": "0.4.4",
		"@astrojs/mdx": "8.1.0",
		"@astrojs/starlight": "0.42.6",
		"@team581/starlight-theme": "0.0.0",
		"astro": "7.4.0",
		"astro-mermaid": "2.1.0",
		"mermaid": "11.17.2"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"knip": "6.42.0",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"oxlint-tsgolint": "7.0.2004",
		"parse5": "8.0.1",
		"typescript": "6.0.3"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.14.0"
}
