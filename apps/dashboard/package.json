{
	"name": "spot-dashboard",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "NODE_ENV=production vp build",
		"preview": "vp preview",
		"check": "vp check",
		"format": "vp fmt --check",
		"format:fix": "vp fmt",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"test": "vp test",
		"test:browser": "playwright test",
		"generate:api": "../../.venv/bin/python ../vision/tools/openapi.py | pnpm dlx --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 openapi-typescript --default-non-nullable=false -o src/api.gen.ts && vp fmt src/api.gen.ts"
	},
	"dependencies": {
		"@spot/camera-viewer": "workspace:*",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"up-fetch": "2.6.1"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.2.1",
		"typescript": "7.1.0-dev.20261103.1",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0"
	}
}
