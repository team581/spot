{
	"name": "spot-dashboard",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "NODE_ENV=production vp build",
		"preview": "vp preview",
		"check": "vp check",
		"format": "vp fmt --check",
		"format:fix": "vp fmt",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"test": "vp test",
		"generate:api": "cargo run -q --manifest-path ../vision/Cargo.toml -- openapi | pnpm dlx --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 openapi-typescript --default-non-nullable=false -o src/api.gen.ts && vp lint --fix src/api.gen.ts && vp fmt src/api.gen.ts"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@fontsource-variable/ibm-plex-sans": "5.3.0",
		"@fontsource-variable/source-sans-3": "5.3.1",
		"@mcap/core": "2.4.0",
		"@spot/camera-viewer": "workspace:*",
		"@tanstack/react-query": "5.105.3",
		"@tanstack/react-router": "1.170.46",
		"class-variance-authority": "0.7.1",
		"cn": "0.5.2",
		"lucide-react": "1.68.0",
		"openapi-fetch": "0.17.0",
		"openapi-react-query": "0.5.4",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"smol-toml": "1.9.1",
		"three": "0.187.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.4",
		"@tanstack/router-plugin": "1.168.48",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/three": "0.187.0",
		"@vitejs/plugin-react": "6.2.1",
		"shadcn": "4.23.0",
		"tailwindcss": "4.3.4",
		"tw-animate-css": "1.4.0",
		"typescript": "7.1.0-dev.20261103.1",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0"
	}
}
