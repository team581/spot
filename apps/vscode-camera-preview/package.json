{
	"name": "spot-camera-preview",
	"displayName": "Spot Camera Preview",
	"version": "0.1.2",
	"description": "Offline preview of Spot robot camera configuration",
	"publisher": "team581",
	"type": "module",
	"main": "./out/extension.cjs",
	"scripts": {
		"package": "pnpm build && node package.mts",
		"test": "node --test test/*.cjs",
		"build": "vp pack && NODE_ENV=production vp build",
		"check": "tsc -p . --noEmit && tsc -p tsconfig.webview.json",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"dependencies": {
		"@spot/camera-viewer": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"@types/vscode": "1.90.0",
		"@vscode/vsce": "4.0.0",
		"typescript": "7.0.2",
		"vite-plus": "1.4.0"
	},
	"contributes": {
		"commands": [
			{
				"command": "spot.previewCameras",
				"title": "Spot: Preview Cameras",
				"icon": "$(device-camera)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "spot.previewCameras",
					"when": "resourceFilename == VisionConfig.java",
					"group": "navigation"
				}
			],
			"explorer/context": [
				{
					"command": "spot.previewCameras",
					"when": "resourceFilename == VisionConfig.java"
				}
			]
		},
		"configuration": {
			"title": "Spot Camera Preview",
			"properties": {
				"spot.cameraPreview.autoOpen": {
					"type": "boolean",
					"default": true,
					"description": "Open camera preview when VisionConfig.java is opened."
				}
			}
		}
	},
	"activationEvents": [
		"onLanguage:java"
	],
	"extensionKind": [
		"workspace"
	],
	"engines": {
		"vscode": "^1.90.0"
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false
		},
		"virtualWorkspaces": false
	}
}
