{
	"name": "spot-camera-preview",
	"displayName": "Spot Camera Preview",
	"version": "0.3.2",
	"description": "Offline preview of Spot robot camera configuration",
	"categories": [
		"Visualization"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/team581/spot-2026.git",
		"directory": "apps/vscode-camera-preview"
	},
	"publisher": "team581",
	"type": "module",
	"main": "./out/extension.cjs",
	"scripts": {
		"package": "pnpm build && vsce package --no-dependencies",
		"test": "mkdir -p test-results && node --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=test-results/junit.xml test/*.cjs",
		"build": "vp pack && NODE_ENV=production vp build",
		"check": "tsc -p . --noEmit && tsc -p tsconfig.webview.json",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"dependencies": {
		"@spot/camera-viewer": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"@types/vscode": "1.145.0",
		"@vscode/vsce": "4.1.0",
		"typescript": "7.0.2",
		"vite-plus": "1.5.0"
	},
	"contributes": {
		"commands": [
			{
				"command": "spot.previewCameras",
				"title": "Spot: Preview Cameras",
				"icon": "$(device-camera)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "spot.previewCameras",
					"when": "resourceFilename == VisionConfig.java || resourceFilename == spot-config.json",
					"group": "navigation"
				}
			],
			"explorer/context": [
				{
					"command": "spot.previewCameras",
					"when": "resourceFilename == VisionConfig.java || resourceFilename == spot-config.json"
				}
			]
		},
		"configuration": {
			"title": "Spot Camera Preview",
			"properties": {
				"spot.cameraPreview.autoOpen": {
					"type": "boolean",
					"default": true,
					"description": "Open camera preview when VisionConfig.java or spot-config.json is opened."
				}
			}
		}
	},
	"activationEvents": [
		"onLanguage:java",
		"workspaceContains:**/src/main/deploy/spot-config.json"
	],
	"extensionKind": [
		"workspace"
	],
	"engines": {
		"vscode": "1.145.0"
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false
		},
		"virtualWorkspaces": false
	}
}
