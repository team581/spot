{
	"name": "spot-docs",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev --host 127.0.0.1 --port 5814",
		"check": "astro sync && tsc --noEmit --runExternalCode",
		"build": "pnpm check && NODE_ENV=production astro build",
		"build:jetson": "DOCS_TARGET=jetson NODE_ENV=production astro build",
		"generate:schema": "cargo run -q --manifest-path ../vision/Cargo.toml -- config-schema > public/spot-config.schema.json && oxfmt public/spot-config.schema.json",
		"preview": "astro preview --host 127.0.0.1 --port 5814",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"test": "mkdir -p test-results && node --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=test-results/junit.xml tests/*.test.ts"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.3.5",
		"@astrojs/markdown-satteri": "0.4.6",
		"@astrojs/mdx": "8.1.2",
		"@astrojs/starlight": "0.42.8",
		"@team581/starlight-theme": "1.0.0",
		"astro": "7.4.7",
		"pele": "1.13.0"
	},
	"devDependencies": {
		"@astrojs/ts-content-mapper": "0.2.0",
		"parse5": "8.1.0",
		"typescript": "7.1.0-dev.20261103.1"
	}
}
