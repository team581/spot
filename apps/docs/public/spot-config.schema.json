{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Spot configuration",
	"description": "Spot's configuration, owned by robot code and sent as TOML over NetworkTables.",
	"type": "object",
	"properties": {
		"cameras": {
			"description": "Cameras keyed by name. Names appear in NetworkTables topics.",
			"type": "object",
			"additionalProperties": {
				"$ref": "#/$defs/CameraConfig"
			},
			"default": {}
		},
		"ignored_tags": {
			"description": "Tag IDs that are never used for pose estimation.",
			"type": "array",
			"default": [],
			"items": {
				"type": "integer",
				"format": "uint32",
				"minimum": 0
			}
		},
		"recording": {
			"$ref": "#/$defs/RecordingConfig",
			"default": {
				"enabled": true,
				"image_fps": 30.0,
				"max_disk_usage_percent": 80.0
			}
		},
		"tag_size": {
			"description": "AprilTag edge length in meters, measured across the outer black border.",
			"type": "number",
			"format": "double",
			"default": 0.1651,
			"minimum": 0.0
		}
	},
	"additionalProperties": false,
	"$defs": {
		"AutoExposure": {
			"type": "string",
			"enum": ["manual", "aperture_priority"]
		},
		"Calibration": {
			"description": "Pinhole intrinsics with OpenCV's five-coefficient distortion model.",
			"type": "object",
			"properties": {
				"cx": {
					"type": "number",
					"format": "double"
				},
				"cy": {
					"type": "number",
					"format": "double"
				},
				"distortion": {
					"description": "`[k1, k2, p1, p2, k3]`",
					"type": "array",
					"items": {
						"type": "number",
						"format": "double"
					},
					"maxItems": 5,
					"minItems": 5
				},
				"fx": {
					"type": "number",
					"format": "double"
				},
				"fy": {
					"type": "number",
					"format": "double"
				},
				"rms": {
					"description": "RMS reprojection error of the calibration in pixels.",
					"type": ["number", "null"],
					"format": "double"
				}
			},
			"additionalProperties": false,
			"required": ["fx", "fy", "cx", "cy", "distortion"]
		},
		"CameraConfig": {
			"type": "object",
			"properties": {
				"calibrations": {
					"description": "Calibrations keyed by resolution, for example `1280x800`.",
					"type": "object",
					"additionalProperties": {
						"$ref": "#/$defs/Calibration"
					},
					"default": {}
				},
				"controls": {
					"$ref": "#/$defs/Controls",
					"default": {}
				},
				"mode": {
					"description": "Capture mode as `WIDTHxHEIGHT@FPS`.",
					"$ref": "#/$defs/Mode",
					"default": "1280x800@120"
				},
				"mount": {
					"description": "Robot-to-camera transform (WPILib coordinates: +X forward, +Y left, +Z up).",
					"$ref": "#/$defs/Mount",
					"default": {
						"pitch": 0.0,
						"roll": 0.0,
						"x": 0.0,
						"y": 0.0,
						"yaw": 0.0,
						"z": 0.0
					}
				},
				"port": {
					"description": "USB port path, for example `1-2.2`. Only used to tell apart cameras that share a\nserial, which is the default for some cameras.",
					"type": ["string", "null"]
				},
				"required": {
					"description": "Spot is not ready unless this camera is streaming and calibrated.",
					"type": "boolean",
					"default": false
				},
				"serial": {
					"description": "USB serial number.",
					"type": "string"
				}
			},
			"additionalProperties": false,
			"required": ["serial"]
		},
		"Controls": {
			"description": "Camera controls. Unset controls are reset to the camera's default.",
			"type": "object",
			"properties": {
				"auto_exposure": {
					"anyOf": [
						{
							"$ref": "#/$defs/AutoExposure"
						},
						{
							"type": "null"
						}
					]
				},
				"exposure_time_absolute": {
					"description": "Exposure time in the camera's units (100 µs for UVC cameras). Applies in manual mode.",
					"type": ["integer", "null"],
					"format": "int32"
				},
				"gain": {
					"type": ["integer", "null"],
					"format": "int32"
				}
			},
			"additionalProperties": false
		},
		"Mode": {
			"description": "Capture mode as WIDTHxHEIGHT@FPS",
			"type": "string",
			"examples": ["1280x800@120"],
			"pattern": "^\\d+x\\d+@\\d+$"
		},
		"Mount": {
			"description": "Translation in meters and rotation in degrees, as WPILib's `Transform3d` and `Rotation3d`.\nPositive pitch points the lens down.",
			"type": "object",
			"properties": {
				"pitch": {
					"type": "number",
					"format": "double",
					"default": 0.0
				},
				"roll": {
					"type": "number",
					"format": "double",
					"default": 0.0
				},
				"x": {
					"type": "number",
					"format": "double",
					"default": 0.0
				},
				"y": {
					"type": "number",
					"format": "double",
					"default": 0.0
				},
				"yaw": {
					"type": "number",
					"format": "double",
					"default": 0.0
				},
				"z": {
					"type": "number",
					"format": "double",
					"default": 0.0
				}
			},
			"additionalProperties": false
		},
		"RecordingConfig": {
			"type": "object",
			"properties": {
				"enabled": {
					"description": "Record MCAP files of matches and robot enables.",
					"type": "boolean",
					"default": true
				},
				"image_fps": {
					"description": "Maximum rate of camera images stored per camera.",
					"type": "number",
					"format": "double",
					"default": 30.0,
					"minimum": 0.0
				},
				"max_disk_usage_percent": {
					"description": "Delete the oldest recordings once the disk is fuller than this percentage.",
					"type": "number",
					"format": "double",
					"default": 80.0,
					"maximum": 99.0,
					"minimum": 1.0
				}
			},
			"additionalProperties": false
		}
	}
}
