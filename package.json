{
	"name": "spot",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"build:jetson": "pnpm --filter spot-docs build:jetson",
		"check": "pnpm -r check",
		"format": "vp fmt --check",
		"format:fix": "vp fmt",
		"lint": "pnpm -r lint",
		"lint:fix": "pnpm -r lint:fix",
		"knip": "knip",
		"test": "pnpm -r test"
	},
	"devDependencies": {
		"knip": "6.48.0",
		"oxfmt": "0.80.0",
		"oxlint": "1.95.0",
		"oxlint-tsgolint": "7.0.2009",
		"vite-plus": "1.8.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.23.0"
}
