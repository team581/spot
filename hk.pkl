amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

hooks {
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = (Builtins.check_conventional_commit) {
        // Keep message paths containing spaces as a single argument.
        check = new Command {
          argv = List("hk", "util", "check-conventional-commit", "{{commit_msg_file}}")
        }
      }
      ["commit-scope"] {
        depends = "conventional-commit"
        check = new Command {
          argv =
            List(
              "awk",
              "-F",
              "[()]",
              """
              /^#/ { next }
              /^[a-z]+[(]/ && $2 !~ /^(camera-viewer|dashboard|docs|nix|vision|vscode-camera-preview)$/ {
                print "Unknown commit scope: " $2 ". See allowed scopes in hk.pkl." > "/dev/stderr"
                exit 1
              }
              { exit }
              """,
              "{{commit_msg_file}}",
            )
        }
      }
    }
  }
}

steps {
  ["pkl-format"] = Builtins.pkl_format
  ["hk-validate"] {
    depends = "pkl-format"
    glob = List("**/*.pkl", "**/PklProject")
    check = "hk validate"
  }
  ["oxfmt"] = (Builtins.oxfmt) {
    prefix = List("pnpm", "exec")
    // Match the existing workspace formatting scope.
    glob =
      List(
        "package.json",
        "release-please-config.json",
        ".release-please-manifest.json",
        "pnpm-workspace.yaml",
        "knip.config.ts",
        "vite.config.ts",
        "oxfmt.config.ts",
        "oxlint.config.ts",
        ".vscode/**",
        ".github/**",
        "apps/dashboard/**",
        "apps/docs/**",
        "apps/vscode-camera-preview/**",
        "packages/camera-viewer/**",
      )
  }
  ["vp-lint"] = (Builtins.vp_lint) {
    prefix = List("pnpm", "exec")
    dir = "{{workspace}}"
    glob =
      List(
        "apps/dashboard/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "packages/camera-viewer/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
      )
  }
  ["oxlint"] = (Builtins.ox_lint) {
    prefix = List("pnpm", "exec")
    workspace_indicator = "package.json"
    dir = "{{workspace}}"
    glob =
      List(
        "apps/docs/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,astro}",
        "apps/vscode-camera-preview/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
      )
  }
  ["knip"] = (Builtins.knip) {
    depends = List("vp-lint", "oxlint")
    prefix = List("pnpm", "exec")
    workspace_indicator = null
    glob = List("**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,astro}", "**/package.json", "pnpm*.yaml")
    check = new Command { argv = List("knip", "--no-progress") }
    // Removing exports and dependencies requires a separate review.
    fix = null
  }
  ["typecheck"] {
    depends = List("oxfmt", "vp-lint", "oxlint")
    glob =
      List(
        "**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,astro}",
        "**/package.json",
        "**/tsconfig*.json",
        "pnpm*.yaml",
      )
    check = "pnpm check"
  }
  ["ruff"] = (Builtins.ruff) {
    prefix = List("uv", "run", "--no-sync")
    glob = List("apps/**/*.py", "tools/**/*.py")
  }
  ["ruff-format"] = (Builtins.ruff_format) {
    prefix = List("uv", "run", "--no-sync")
    glob = List("apps/**/*.py", "tools/**/*.py")
    depends = "ruff"
  }
  ["ty"] = (Builtins.ty) {
    depends = "ruff"
    prefix = List("uv", "run", "--no-sync")
    glob = List("apps/vision/src/**/*.py", "**/pyproject.toml", "uv.lock")
    check = new Command { argv = List("ty", "check") }
  }
  ["vulture"] {
    depends = "ruff"
    glob = List("**/*.py", "**/pyproject.toml", "uv.lock")
    check = "uv run --no-sync vulture"
  }
}
