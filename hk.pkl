amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"

hooks {
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = (Builtins.check_conventional_commit) {
        allowed_scopes =
          List(
            "camera-viewer",
            "dashboard",
            "docs",
            "java-client",
            "nix",
            "vision",
            "vscode-camera-preview",
          )
      }
    }
  }
}

steps {
  ["pkl-format"] = Builtins.pkl_format
  ["hk-validate"] {
    depends = "pkl-format"
    glob = List("**/*.pkl", "**/PklProject")
    check = "hk validate"
  }
  ["oxfmt"] = (Builtins.oxfmt) {
    prefix = List("pnpm", "exec")
    // Match the existing workspace formatting scope.
    exclude =
      super.exclude
        + List(
          ".agents/**",
          ".claude/**",
          "AGENTS.md",
          "README.md",
          "apps/vision/**",
          "mise.toml",
          "netlify.toml",
          "nix/**",
          "openspec/**",
          "packages/java-client/**",
          "renovate.json",
        )
  }
  ["vp-lint"] = (Builtins.vp_lint) {
    prefix = List("pnpm", "exec")
    dir = "{{workspace}}"
    glob =
      List(
        "apps/dashboard/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "packages/camera-viewer/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
      )
  }
  ["oxlint"] = (Builtins.ox_lint) {
    prefix = List("pnpm", "exec")
    workspace_indicator = "package.json"
    dir = "{{workspace}}"
    glob =
      List(
        "apps/docs/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,astro}",
        "apps/vscode-camera-preview/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
      )
  }
  ["react-doctor"] {
    glob =
      List("apps/dashboard/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}", "apps/dashboard/package.json")
    check = "pnpm --filter spot-dashboard run react-doctor"
  }
  ["knip"] = (Builtins.knip) {
    depends = List("vp-lint", "oxlint")
    prefix = List("pnpm", "exec")
    workspace_indicator = null
    glob = List("**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,astro}", "**/package.json", "pnpm*.yaml")
    check = new Command { argv = List("knip", "--no-progress") }
    // Removing exports and dependencies requires a separate review.
    fix = null
  }
  ["typecheck"] {
    depends = List("oxfmt", "vp-lint", "oxlint")
    glob =
      List(
        "**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,astro}",
        "**/package.json",
        "**/tsconfig*.json",
        "pnpm*.yaml",
      )
    check = "pnpm check"
  }
  ["cargo-fmt"] {
    glob = List("apps/vision/**/*.rs")
    check = "cargo fmt --manifest-path apps/vision/Cargo.toml --check"
    fix = "cargo fmt --manifest-path apps/vision/Cargo.toml"
  }
  ["clippy"] {
    depends = "cargo-fmt"
    glob =
      List(
        "apps/vision/**/*.rs",
        "apps/vision/Cargo.*",
        "apps/vision/build.rs",
        "apps/vision/cpp/**",
      )
    check =
      "cargo clippy --manifest-path apps/vision/Cargo.toml --all-targets --locked -- -D warnings"
    fix =
      "cargo clippy --manifest-path apps/vision/Cargo.toml --all-targets --locked --fix --allow-dirty -- -D warnings"
  }
  ["spotless"] {
    glob = List("packages/java-client/**/*.{java,gradle}")
    check = "./gradlew spotlessCheck"
    fix = "./gradlew spotlessApply"
  }
}
