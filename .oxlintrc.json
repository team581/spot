{
	"categories": {
		"correctness": "error",
		"perf": "error"
	},
	"ignorePatterns": ["**/out/**", "apps/vscode-camera-preview/media/viewer.js"],
	"rules": {
		"no-await-in-loop": "off",
		"no-unused-expressions": [
			"error",
			{
				"allowShortCircuit": true,
				"allowTernary": true
			}
		]
	}
}
